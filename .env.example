# ─── Discord ──────────────────────────────────────────────
# Token del bot en Discord Developer Portal
DISCORD_TOKEN=
# Client ID de tu bot de Discord
CLIENT_ID=
# Opcional: ID de servidor para actualizar comandos instantáneamente en desarrollo
GUILD_ID=

# ─── Configuración del Bot ────────────────────────────────
BOT_STATUS=/tts | Ignite Sound
EMBED_COLOR=#FF4500
# Prefijo opcional si deseas soporte para comandos de texto tradicionales
PREFIX=!
# Tiempo en segundos antes de salir de un canal vacío (0 = nunca)
LEAVE_ON_EMPTY=60
# Límite máximo de caracteres por mensaje TTS (ej: 300)
MAX_TTS_LENGTH=300
# Voz por defecto para TTS (ej: es-MX-DaliaNeural, es-ES-AlvaroNeural, loquendo)
DEFAULT_VOICE=es-MX-DaliaNeural
# Modo depuración detallada (true/false)
DEBUG=false
# Desactivar colores en consola (true/false)
NO_COLOR=

# ─── Loquendo & Proveedores Externos ──────────────────────
# Opcional: URL personalizada para endpoint de Loquendo (si se usa servidor propio o proxy)
LOQUENDO_API_URL=

# ─── API REST / Dashboard (ignite-frontend) ───────────────
API_ENABLED=true
PORT=3002
# Secreto para Authorization: Bearer <API_SECRET> (mínimo 32 caracteres en producción)
API_SECRET=
# Retrocompatibilidad opcional con API_KEY
API_KEY=
# Orígenes permitidos separados por comas (ej: http://localhost:3000)
API_ALLOWED_ORIGINS=
# Límite de peticiones por minuto para la API
API_RATE_LIMIT_PER_MINUTE=120
